# Copy to .env with `python deploy/make_env.py`; every change-me-* value is replaced by a random secret.
# Never commit .env. Each service receives only its own database password.
GSN_VERSION=dev
POSTGRES_PASSWORD=change-me-superuser
GSN_DB_MIGRATE_PASSWORD=change-me-migrate
GSN_DB_WEB_PASSWORD=change-me-web
GSN_DB_ENGINE_PASSWORD=change-me-engine
GSN_DB_WORKER_PASSWORD=change-me-worker
GSN_ADMIN_PUBLISH=127.0.0.1:8081
GSN_SITE_ADDRESS=:80
