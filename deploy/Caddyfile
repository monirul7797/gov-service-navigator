# Edge proxy for the public site. The address comes from GSN_SITE_ADDRESS (default ":80", plain
# HTTP). HSTS and port 443 arrive in milestone M4 together with the domain name.
{$GSN_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}

	reverse_proxy web:8080
}
